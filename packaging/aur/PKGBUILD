# Maintainer: Pavlos Kokozidis <paulkokos@yahoo.gr>
pkgname=dipal
pkgver=0.1.2
pkgrel=1
pkgdesc="Digital Image Processing and Analysis Library - A modern C++23 image processing library"
arch=('x86_64')
url="https://github.com/paulkokos/DIPAL"
license=('MIT')
depends=()
makedepends=('cmake' 'ninja' 'gcc>=13')
source=("$pkgname-$pkgver.tar.gz::https://github.com/paulkokos/DIPAL/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # Update with actual sha256sum

build() {
    cd "DIPAL-$pkgver"
    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_CXX_STANDARD=23 \
        -DBUILD_TESTS=OFF \
        -DBUILD_EXAMPLES=OFF
    cmake --build build
}

package() {
    cd "DIPAL-$pkgver"
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
